{
  "_version": "1.89.0",
  "sap.app": {
    "id": "ui5learning",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [""],
      "fallbackLocale": ""
    },
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.33.0",
      "toolsId": "55acde9f-ca8f-4d99-8902-dbf4c8571eec"
    },
    "dataSources": {
      "demoServiceV2": {
        "uri": "/V2/OData/ODataSVC/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0",
          "localUri": "localService/metadataV2.xml"
        }
      },
      "demoServiceV4": {
        "uri": "/V4/OData/ODataSVC/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0",
          "localUri": "localService/metadataV4.xml"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "handleValidation": false,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "books": {
        "type": "sap.ui.model.json.JSONModel",
        "uri": "model/books.json"
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "ui5learning.i18n.i18n",
          "supportedLocales": [""],
          "fallbackLocale": ""
        }
      },
      "demoV2": {
        "dataSource": "demoServiceV2",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "demoV4": {
        "dataSource": "demoServiceV4",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "ui5learning.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteTab",
          "pattern": "tab/{tabKey}",
          "target": [
            "TargetMain"
          ]
        },
        {
          "name": "RouteProduct",
          "pattern": "Product/{productId}",
          "target": [
            "TargetProduct"
          ]
        },
        {
          "name": "RouteMain",
          "pattern": ":path*:",
          "target": [
            "TargetMain"
          ]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "Main"
        },
        "TargetProduct": {
          "id": "Product",
          "name": "Product"
        }
      }
    },
    "rootView": {
      "viewName": "ui5learning.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
