<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">

    <Dialog
        id="productV2Dialog"
        core:require="{
            StringType: 'sap/ui/model/odata/type/String',
            DateTimeType: 'sap/ui/model/odata/type/DateTime',
            Int32Type: 'sap/ui/model/odata/type/Int32',
            DecimalType: 'sap/ui/model/odata/type/Decimal'
        }"
        title="{= ${view>/productV2EditMode} ? ${i18n>editProductTitle} : ${i18n>addProductTitle} }"
        contentWidth="40rem"
        busyIndicatorDelay="0"
        afterClose=".onProductV2DialogAfterClose">

        <content>
            <form:SimpleForm
                id="productV2Form"
                editable="true"
                layout="ColumnLayout">

                <Label
                    id="productV2NameLabel"
                    text="{i18n>productName}"
                    required="true" />
                <Input
                    id="productV2NameInput"
                    value="{
                        path: 'demoV2>Name',
                        type: 'StringType'
                    }"
                    change=".onFieldChange" />

                <Label
                    id="productV2DescriptionLabel"
                    text="{i18n>productDescription}"
                    required="true" />
                <Input
                    id="productV2DescriptionInput"
                    value="{
                        path: 'demoV2>Description',
                        type: 'StringType'
                    }"
                    change=".onFieldChange" />

                <Label
                    id="productV2ReleaseDateLabel"
                    text="{i18n>productReleaseDate}"
                    required="true" />
                <DatePicker
                    id="productV2ReleaseDatePicker"
                    value="{
                        path: 'demoV2>ReleaseDate',
                        type: 'DateTimeType',
                        constraints: {
                            displayFormat: 'Date'
                        }
                    }"
                    maxDate="{view>/maxReleaseDate}"
                    change=".onFieldChange" />

                <Label
                    id="productV2DiscontinuedDateLabel"
                    text="{i18n>productDiscontinuedDate}" />
                <DatePicker
                    id="productV2DiscontinuedDatePicker"
                    value="{
                        path: 'demoV2>DiscontinuedDate',
                        type: 'DateTimeType',
                        constraints: {
                            displayFormat: 'Date'
                        }
                    }" />

                <Label
                    id="productV2RatingLabel"
                    text="{i18n>productRating}"
                    required="true" />
                <Input
                    id="productV2RatingInput"
                    value="{
                        path: 'demoV2>Rating',
                        type: 'Int32Type'
                    }"
                    change=".onFieldChange" />

                <Label
                    id="productV2PriceLabel"
                    text="{i18n>productPrice}"
                    required="true" />
                <Input
                    id="productV2PriceInput"
                    value="{
                        path: 'demoV2>Price',
                        type: 'DecimalType',
                        constraints: {
                            scale: 'variable'
                        }
                    }"
                    change=".onFieldChange" />
            </form:SimpleForm>
        </content>

        <beginButton>
            <Button
                id="saveProductV2Button"
                text="{i18n>save}"
                type="Emphasized"
                press=".onSaveProductV2" />
        </beginButton>

        <endButton>
            <Button
                id="cancelProductV2Button"
                text="{i18n>cancel}"
                press=".onCancelProductV2" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
